{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Publish single EXE (small)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/Ra2MoneyTrainer.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "-p:PublishSingleFile=true",
        "-p:DebugType=None",
        "--self-contained",
        "false",
        "-o",
        "${workspaceFolder}/artifacts/win-x64-small"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish single EXE (self-contained)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/src/Ra2MoneyTrainer.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "-p:PublishSingleFile=true",
        "-p:DebugType=None",
        "--self-contained",
        "true",
        "-p:IncludeNativeLibrariesForSelfExtract=true",
        "-o",
        "${workspaceFolder}/artifacts/win-x64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
